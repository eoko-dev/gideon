# Discord Bot Token
DISCORD_TOKEN=your_discord_token_here

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# System prompt for the AI assistant
SYSTEM_PROMPT=You are Gideon, a Discord AI chatbot designed for casual and helpful interactions. Maintain a supportive and amiable tone while engaging users. Allow for casual language, including occasional lighthearted banter, while fostering a relaxed atmosphere. Aim to be helpful, approachable, and informal, providing information and assistance accessibly and understandably. Offer gentle critiques to chat members with playful, humorous observations, styled after a witty, slightly sardonic, and eloquent British butler. Keep replies under 400 words.

# Default model to use (will be used until dynamic model list is loaded)
DEFAULT_MODEL=openrouter/openai/gpt-4o-mini

# Data directory path. ONLY CHANGE THIS PATH IF YOU KNOW WHAT YOU ARE DOING! IT IS SET TO FUNCTION WITH DOCKER BY DEFAULT
DATA_DIRECTORY=/app/data # Only change this value if you are NOT using Docker

# AI Horde API Key (optional)
AI_HORDE_API_KEY=your_ai_horde_api_key_here

# Cloudflare Worker
CLOUDFLARE_WORKER_URL=https://your-worker-url.workers.dev/
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here  # Optional
# OpenAI API Key (for Dall-E image generation)
OPENAI_API_KEY=your_openai_api_key_here

# ComfyUI Configuration
# URL of your ComfyUI server (local or remote)
# Examples: http://127.0.0.1:8188 (local) or http://your-server.com:8188 (remote)
# Leave empty to disable ComfyUI provider
COMFYUI_URL=http://127.0.0.1:8188

# ─── Native Tool Calling ────────────────────────────────────────────────────
# Enables native LLM tool calling for @mentions. When enabled, the primary LLM
# model receives tool definitions (reminder, image generation, calculation, etc.)
# and decides natively whether to call a tool or respond conversationally.
# This replaces the old intent classification system with a single LLM call.
#
# Set to TRUE to enable. Requires a model that supports tool/function calling
# (most modern models like GPT-4o, Claude 3.5, Gemini 2.0, GLM, etc. support this).
TOOL_CALLING_ENABLED=TRUE

# Backward compatibility: Setting INTENT_DISCOVERY=TRUE also enables tool calling
# INTENT_DISCOVERY=FALSE

# Maximum number of tool-call round-trips before forcing a text response
# Prevents infinite loops if the model keeps calling tools
# Default: 3
TOOL_CALLING_MAX_ITERATIONS=3

# ─── Removed settings ────────────────────────────────────────────────────────
# INTENT_DETECTION_MODEL and INTENT_CONFIDENCE_THRESHOLD no longer exist —
# the old intent classification system was replaced by native tool calling.
# (INTENT_DISCOVERY=TRUE is still honored as an alias for TOOL_CALLING_ENABLED.)

# Encryption Master Key for API key storage (required for dashboard key management)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=your_encryption_master_key_here

# Admin Dashboard - Web-based management interface
# Set to TRUE to enable the admin dashboard web server
DASHBOARD_ENABLED=FALSE
# Port for the dashboard web server (default: 8080)
DASHBOARD_PORT=8080
# Secret key for dashboard authentication (required when dashboard is enabled)
# Generate a strong random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET=your_dashboard_secret_here